MONAD_TESTNET_RPC_URL=
MONAD_TESTNET_CHAIN_ID=
# 当前 Monad Testnet 合约地址已内置于 lib/chain.ts。仅在切换到其他合约时设置此可选覆盖值。
NEXT_PUBLIC_ACTIVE_REGISTRY_ADDRESS=
NEXT_PUBLIC_MONAD_TESTNET_RPC_URL=
AI_API_KEY=
APP_ORIGIN=http://localhost:3000
# Optional AI explanation proxy. Keep the key server-side and never use NEXT_PUBLIC_.
AI_MATCH_URL=https://api.moonshot.cn/v1/chat/completions
AI_MATCH_MODEL=kimi-k3
# Required when AI_API_KEY is configured. Without shared rate limit storage,
# /api/ai stays disabled and the app uses basic matching.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel 的 Upstash 集成会自动提供 KV_REST_API_URL 和 KV_REST_API_TOKEN，可替代上面两项。
